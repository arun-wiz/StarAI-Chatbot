# Image to be pushed by GitHub Actions (rendered into manifests)
APP_IMAGE=879381248241.dkr.ecr.us-east-1.amazonaws.com/starai-chatbot:latest

# Langflow settings (gateway talks to it on localhost in the same Pod)
FLOW_ID=68660017-5c7f-4a8b-992e-773fca5dc5a7

# AI agent demo settings
# AGENT_PROVIDER can be local, bedrock, bedrock-agent, or vertex.
AGENT_PROVIDER=local
# AGENT_STORAGE_PROVIDER can be local, s3, or gcs.
AGENT_STORAGE_PROVIDER=local
AGENT_LOCAL_DATA_DIR=/app/data
AGENT_PII_BUCKET=
AGENT_CUSTOMER_OBJECT=customer_pii.csv
AGENT_PAYMENTS_OBJECT=payment_records.csv
AGENT_DEMO_UNSAFE=false

# AWS Bedrock settings
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# GCP Vertex AI settings
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL_ID=gemini-2.5-flash

# Public DNS + ACM cert for ALB
PUBLIC_DOMAIN=staraichat.sgcybersec.com
ALB_ACM_ARN=arn:aws:acm:us-east-1:879381248241:certificate/35b69081-e4df-4f8f-b51b-d7f5746a0d97

# (CI/CD values are set via GitHub Actions repo Variables/Secrets)
